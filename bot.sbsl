#совместимость 10.0
структура Местоположение
    пер X: Число = 0
    пер Y: Число = 0
;

структура Бот
    пер ТекущееПоложение:Местоположение
    пер Цель:Местоположение?= Неопределено
    метод ИдтиВправо()
        ТекущееПоложение.X = ТекущееПоложение.X+7
    ;
    метод ИдтиВлево()
        ТекущееПоложение.X = ТекущееПоложение.X-1
    ;
    метод ИдтиВниз()
        ТекущееПоложение.Y = ТекущееПоложение.Y-1
    ;
    метод ИдтиВверх()
        ТекущееПоложение.Y = ТекущееПоложение.Y+1
    ;
;

метод Скрипт()
    пер ИгровойБот:Бот = новый Бот()
    ИгровойБот.ИдтиВправо()
    Консоль.Записать(ИгровойБот.ТекущееПоложение.X)
;