#совместимость 10.0
метод Скрипт()
    пер ДверьОткрыта = Ложь
    для НомерПопытки = 1 по 3
        пер Пароль = Консоль.СчитатьСтроку(
            "Попытка $НомерПопытки из 3. Назовите пароль: "
        )
        если Пароль == "дракон"
            ДверьОткрыта = Истина
            прервать
        ;
    ;
    если ДверьОткрыта
        Консоль.Записать("Дверь в подземелье открыта")
    иначе
        Консоль.Записать("Дверь осталась закрыта")
    ;
;
