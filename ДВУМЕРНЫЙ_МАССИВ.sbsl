#совместимость 10.0
метод Скрипт()
    пер Коридор = [1, 0, 0, 0, 1]
    пер ПозицияИгрока = 2
    Консоль.Записать("Коридор: $Коридор")
    Консоль.Записать("Игрок стоит в клетке с индексом $ПозицияИгрока")
    Консоль.Записать("Блок под игроком: ${Коридор[ПозицияИгрока]}")
    Консоль.Записать("Блок слева: ${Коридор[ПозицияИгрока - 1]}")
    Консоль.Записать("Блок справа: ${Коридор[ПозицияИгрока + 1]}")

    пер ВерхняяСтрока = [1, 1, 1, 1, 1]
    пер СредняяСтрока = Коридор
    пер НижняяСтрока = [1, 1, 1, 1, 1]
    пер Таблица = [
        ВерхняяСтрока,
        СредняяСтрока,
        НижняяСтрока
    ]

    пер СтрокаКарты = Таблица[1]
    Консоль.Записать("Строка с индексом 1: $СтрокаКарты")
    Консоль.Записать("Размер строки: ${СтрокаКарты.Размер()}")

    пер КлеткаЧерезСтроку = СтрокаКарты[2]
    Консоль.Записать("Клетка через переменную: $КлеткаЧерезСтроку")

    пер КлеткаНапрямую = Таблица[1][2]
    Консоль.Записать("Клетка напрямую: $КлеткаНапрямую")

    // Исправлено: используем метод Установить() вместо присваивания через []
    СтрокаКарты.Установить(2, 1)
    Консоль.Записать("Изменили через строку: ${Таблица[1][2]}")

    Таблица[1].Установить(3, 1)
    Консоль.Записать("Изменили через таблицу: ${СтрокаКарты[3]}")
    Консоль.Записать("Средняя строка: $СтрокаКарты")

    пер Высота = Таблица.Размер()
    пер ПерваяСтрока = Таблица[0]
    пер ШиринаЧерезСтроку = ПерваяСтрока.Размер()
    пер ШиринаНапрямую = Таблица[0].Размер()
    Консоль.Записать("Высота: $Высота")
    Консоль.Записать("Ширина через строку: $ШиринаЧерезСтроку")
    Консоль.Записать("Ширина напрямую: $ШиринаНапрямую")
;
