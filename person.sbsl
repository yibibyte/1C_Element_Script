#совместимость 10.0
структура Местоположение
    пер X: Число = 1
    пер Y: Число = 0
;

структура Персонаж
    пер ХП: Число
    пер Координаты: Местоположение
    пер КоординатыЦели: Местоположение? = Неопределено
    пер Имя: Строка? = Неопределено
    пер Жив: Булево = Истина
;

метод Скрипт()
    пер перс1: Персонаж = новый Персонаж(100,новый Местоположение(1,0),Неопределено,"Вася",Истина)
    перс1.Имя = "Даня"
    перс1.Координаты.X = 1
    перс1.Координаты.Y = 2
    Консоль.Записать(перс1)
;