#совместимость 10.0
структура Питомец
    пер Кличка: Строка = "Барсик"
    пер Сытость: Число = 5
    пер Радость: Число = 5
    пер Живой: Булево = Истина
    метод Статус()        
    ;
    метод Покормить()
    ;
    метод Поиграть ()
    ;
    метод ПропуститьВремя()
    ;
    метод ПроверитьЖизнь()
    ;
;    
метод Скрипт()
    пер МойПитомец = новый Питомец("Пиксель",3,3,Истина)
    МойПитомец.Статус()
    МойПитомец.Поиграть()
    МойПитомец.Статус()
    МойПитомец.ПропуститьВремя()
    МойПитомец.Статус()
    МойПитомец.ПропуститьВремя()
    МойПитомец.Статус()
    МойПитомец.Покормить()
;