#совместимость 10.0
структура Питомец
    пер Кличка: Строка 
    пер Сытость: Число
    пер Радость: Число
    
    метод Покормить()
        если Сытость >= 1
            Консоль.Записать(Кличка + " вкусно поел!")
        иначе
            Консоль.Записать("Мама уже покормила")
        ;
    ;

    метод Поиграть()
        если Радость >= 1
             Консоль.Записать(Кличка + " весело поиграл!")   
        иначе
            Консоль.Записать(Кличка + " не хочет играть")
        ;
    ;
;
метод Скрипт()
    пер Кличка = Консоль.СчитатьСтроку("Введи кличку:")
    пер Сытость = Консоль.СчитатьЧисло("Введи сытость:")
    пер Радость = Консоль.СчитатьЧисло("Введи радость:")
    пер МойПитомец = новый Питомец(Кличка, Сытость, Радость)
    МойПитомец.Поиграть()
    МойПитомец.Покормить()
;
