#совместимость 10.0
метод ПовторитьШаги()
    для НомерШага = 1 по 5
        Консоль.Записать("Герой делает шаг")
    ;
;
метод ПоказатьНомерШага()
    для НомерШага = 1 по 5
        Консоль.Записать("Шаг $НомерШага из 5")
    ;
;
метод НарисоватьПустойКоридор()
    пер Коридор: Строка = ""
    для НомерКлетки = 0 по 8
        Коридор += "."
    ;
    Консоль.Записать(Коридор)
;
метод НарисоватьКоридорСГероем()
    пер ДлинаКоридора = 9
    пер ПозицияИгрока = 3
    пер Коридор: Строка = ""
    для X = 0 по ДлинаКоридора - 1
        если X == 0 или X == ДлинаКоридора - 1
            Коридор += "X"
        иначе если X == ПозицияИгрока
            Коридор += "V"
        иначе
            Коридор += "."
        ;
    ;
    Консоль.Записать(Коридор)
;
метод Скрипт()
    Консоль.Записать("Повторяем шаги")
    ПовторитьШаги()
    Консоль.Записать("Показываем номер шага")
    ПоказатьНомерШага()
    Консоль.Записать("Рисуем пустой коридор")
    НарисоватьПустойКоридор()
    Консоль.Записать("Рисуем коридор с героем")
    НарисоватьКоридорСГероем()
;

