#совместимость 10.0
// ============================================================
// ИНТЕРАКТИВНАЯ ДЕМО-ПРОГРАММА ПО МАТЕРИАЛАМ ЗАНЯТИЙ 8-21
// 1С:Предприятие.Элемент Скрипт
// Каждая стадия ждёт нажатия Enter — можно идти шаг за шагом,
// перед каждым запуском сначала прогнозируйте результат,
// потом сверяйте его с выводом в консоли.
// ============================================================

метод Скрипт()

    // ---------- ЭТАП 1. Переменные и арифметика ----------
    // Задание 8: числовые переменные, арифметическое выражение,
    // интерполяция строки ${}
    Консоль.Записать("=== ЭТАП 1. Считаем очки уровня ===")

    пер Враги = 8          // числовая переменная: сколько врагов
    пер ОчкиЗаВрага = 50   // сколько очков даёт один враг
    пер Бонус = 120        // бонус за прохождение
    пер Штраф = 40         // штраф за ошибки

    // Порядок операций как в математике: сначала умножение,
    // потом сложение и вычитание слева направо.
    // ${...} — интерполяция: внутри скобок сначала вычисляется ЧИСЛО,
    // затем оно подставляется в строку. Текст "Итог уровня: " числом не является!
    Консоль.Записать("Итог уровня: ${Враги * ОчкиЗаВрага + Бонус - Штраф}")
    // Прогноз: 8 * 50 = 400, 400 + 120 = 520, 520 - 40 = 480

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 2. Обмен значений переменных ----------
    // Задание 12: аналогия с двумя стаканами и третьим пустым
    Консоль.Записать("=== ЭТАП 2. Обмен значений через временную переменную ===")

    пер А = 1
    пер Б = 2

    пер В = А   // шаг 1: СОХРАНИТЬ значение А во временной переменной
    А = Б       // шаг 2: ПЕРЕНЕСТИ значение Б в А (старое А уже в В, не потерялось)
    Б = В       // шаг 3: ВОССТАНОВИТЬ сохранённое значение в Б

    Консоль.Записать("А = $А, Б = $Б")
    // Прогноз: А = 2, Б = 1.
    // Попробуйте убрать строку "пер В = А" — увидите, что исходное А потеряется

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 3. Инкремент и декремент ----------
    // Задание 13: сокращённые формы меняют САМУ переменную,
    // а выражение в выводе — только считают число для одной строки
    Консоль.Записать("=== ЭТАП 3. Как реально меняется переменная ===")

    пер Уровень = 1
    Уровень += 1   // то же самое, что Уровень = Уровень + 1
    Консоль.Записать("Уровень после победы: $Уровень")      // 2

    Уровень -= 3   // декремент: уменьшаем сразу на 3
    Консоль.Записать("Уровень после поражения: $Уровень")   // -1
    // Обратите внимание: изменилась сама переменная Уровень,
    // а не просто напечаталось какое-то число

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 4. Логические выражения ----------
    // Задание 16: результат сравнения — Истина или Ложь,
    // его можно сохранить в переменную и вывести
    Консоль.Записать("=== ЭТАП 4. Логика: персонаж и дверь ===")

    пер ЕстьКлюч = Ложь    // логическое значение, не число и не текст
    пер Очки = 342
    пер ПорогОчков = 100

    // Само сравнение возвращает логическое значение — сохраняем его:
    пер ПереходитНаДругойЛвл = Очки >= ПорогОчков
    Консоль.Записать("Переводим юзера на другой лвл: $ПереходитНаДругойЛвл")

    // Координаты персонажа и двери
    пер XПерса = 3
    пер УПерса = 2
    пер XДвери = 3
    пер YДвери = 2

    // == СРАВНИВАЕТ, = ПРИСВАИВАЕТ — это разные операции!
    пер НаОднойВертикали = XДвери == XПерса
    пер НаОднойГоризонтали = YДвери == УПерса

    // или: достаточно ОДНОЙ истинной части (видит дверь)
    пер ПерсВидитДверь = НаОднойВертикали или НаОднойГоризонтали
    // и: должны быть истинны ОБЕ части (стоит у двери)
    пер ПерсУДвери = НаОднойВертикали и НаОднойГоризонтали
    // и: и у двери, И есть ключ
    пер МогуОткрытьДверь = ЕстьКлюч и ПерсУДвери

    Консоль.Записать("Персонаж видит дверь: $ПерсВидитДверь")
    Консоль.Записать("Персонаж у двери: $ПерсУДвери")
    Консоль.Записать("Может открыть дверь: $МогуОткрытьДверь")
    // Прогноз до запуска: Истина, Истина, Ложь — ключа-то нет!

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 5. Условный оператор ----------
    // Задание 18: если / иначе если / иначе — цепочка проверок сверху вниз
    Консоль.Записать("=== ЭТАП 5. Ветвление: выбираем звание ===")

    пер ОчкиИгрока = 342
    если ОчкиИгрока >= 500
        Консоль.Записать("Мастер")
    иначе если ОчкиИгрока >= 100
        Консоль.Записать("Боец")     // сработает эта ветка: 342 >= 100
    иначе
        Консоль.Записать("Новичок")
    ;
    // Проверки идут сверху вниз: после ПЕРВОЙ истинной остальные пропускаются.
    // Поменяйте ОчкиИгрока на 50 и на 600 — попадёте в другие ветки

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 6. Случайный генератор ----------
    // Задание 9: объект, оператор "новый", метод через точку
    Консоль.Записать("=== ЭТАП 6. Бросаем кубик ===")

    пер Кубик = новый СлучайныйГенератор()  // "новый" создаёт объект-генератор
    // Метод вызывается через точку: ОБЪЕКТ.МЕТОД(параметры)
    // Верхняя граница НЕ включается: (1, 7) даёт числа от 1 до 6
    пер Грани = Кубик.СлучайноеЦелое(1, 7)
    Консоль.Записать("На кубике выпало: $Грани")
    // Эксперимент: поставьте (1, 101) — получите диапазон от 1 до 100

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 7. Мини-проект «Танки на минималках» ----------
    // Задание 10: всё вместе — переменные, арифметика, ввод, генератор
    Консоль.Записать("=== ЭТАП 7. Статистика боя ===")

    пер Генератор = новый СлучайныйГенератор()
    пер ПодбитыеТанки = Генератор.СлучайноеЦелое(5, 16)      // от 5 до 15
    пер УничтоженныеЗдания = Генератор.СлучайноеЦелое(3, 12) // от 3 до 11

    // Ввод с клавиатуры: значения будут участвовать в арифметике,
    // поэтому нужен СчитатьЧисло, а не СчитатьСтроку
    пер ОчкиЗаТанк = Консоль.СчитатьЧисло("Очки за один танк: ")
    пер ОчкиЗаЗдание = Консоль.СчитатьЧисло("Очки за одно здание: ")
    пер БонусныеОчки = 500

    // Вычисления делаем заранее и кладём в переменные —
    // так статистику легко пересобирать и менять
    пер ОчкиЗаТанки = ПодбитыеТанки * ОчкиЗаТанк
    пер ОчкиЗаЗдания = УничтоженныеЗдания * ОчкиЗаЗдание

    Консоль.Записать("=== Статистика боя ===")
    Консоль.Записать("Подбито танков: $ПодбитыеТанки")
    Консоль.Записать("Очки за один танк: $ОчкиЗаТанк")
    Консоль.Записать("Очки за танки: $ОчкиЗаТанки")
    Консоль.Записать("Уничтожено зданий: $УничтоженныеЗдания")
    Консоль.Записать("Очки за одно здание: $ОчкиЗаЗдание")
    Консоль.Записать("Очки за здания: $ОчкиЗаЗдания")
    Консоль.Записать("Бонус за бой: $БонусныеОчки")
    Консоль.Записать("Всего очков: ${ОчкиЗаТанки + ОчкиЗаЗдания + БонусныеОчки}")
    // Запустите дважды с одинаковыми очками — количества целей и суммы изменятся:
    // их делает новыми генератор случайных чисел

    Консоль.СчитатьСтроку("Нажмите Enter для следующего этапа > ")

    // ---------- ЭТАП 8. Практикум «Логово дракона» ----------
    // Задание 20: генератор + логическое выражение + цепочка ветвления
    Консоль.Записать("=== ЭТАП 8. Логово дракона: сражение ===")
    Консоль.СчитатьСтроку("Приготовьтесь к встрече с Драконом > ")

    пер Результат = Кубик.СлучайноеЦелое(1, 7)   // бросок кубика: 1..6

    // Условие победы храним в логической переменной
    пер Победа = Результат == 3 или Результат == 4

    если Победа
        Консоль.Записать("Победа")
    иначе если Результат < 3
        Консоль.Записать("Поражение")
    иначе если Результат == 5
        Консоль.Записать("Приручить")
    иначе
        Консоль.Записать("Убежали")
    ;
    // Запускайте несколько раз: при 6 сработает ветка "иначе" — Убежали.
    // Прежнее условие "Результат > 3" здесь не подошло бы:
    // оно ошибочно отнесло бы 5 и 6 к победе
;
