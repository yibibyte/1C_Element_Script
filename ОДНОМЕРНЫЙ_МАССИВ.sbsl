#совместимость 10.0
метод ПоложитьВРюкзак(Рюкзак: Массив<Строка>, Предмет: Строка)
    Рюкзак.Добавить(Предмет)
;
метод Скрипт()
    пер Инвентарь: Массив<Строка> = ["Ключ", "Фонарь", "Ржавый меч"]
    Консоль.Записать("В инвентаре ${Инвентарь.Размер()} предмета")
    Консоль.Записать("$Инвентарь")
    пер АктивныйСлот = 1
    Консоль.Записать("В руке: ${Инвентарь[АктивныйСлот]}")
    Инвентарь[АктивныйСлот] = "Яркий фонарь"
    Консоль.Записать("Фонарь улучшен: ${Инвентарь[АктивныйСлот]}")
    Консоль.Записать("Предметов по-прежнему: ${Инвентарь.Размер()}")
    пер ИнвентарьПередОзером = Инвентарь
    Инвентарь.Добавить("Лодка")
    Консоль.Записать("Инвентарь сейчас: $Инвентарь")
    Консоль.Записать("Инвентарь перед озером: $ИнвентарьПередОзером")
    пер ИндексМеча = Инвентарь.Найти("Ржавый меч")
    если ИндексМеча != Неопределено
        Инвентарь[ИндексМеча] = "Элитный меч"
        Консоль.Записать("Меч улучшен")
    ;
    пер ИндексКлюча = Инвентарь.Найти("Ключ")
    если ИндексКлюча != Неопределено
        пер ИспользованныйКлюч = Инвентарь.УдалитьПоИндексу(ИндексКлюча)
        Консоль.Записать("$ИспользованныйКлюч остался в замке")
    ;
    Консоль.Записать("После двери предметов: ${Инвентарь.Размер()}")
    Консоль.Записать("$Инвентарь")
    пер ЯщикСокровищ = ["Зелье", "Кристалл", "Свиток"]
    пер Генератор = новый СлучайныйГенератор()
    пер СлучайныйИндекс = Генератор.СлучайноеЦелое(0, ЯщикСокровищ.Граница())
    пер Лут = ЯщикСокровищ[СлучайныйИндекс]
    ПоложитьВРюкзак(Инвентарь, Лут)
    Консоль.Записать("Из сундука: $Лут")
    Консоль.Записать("$Инвентарь")
;
