метод ЭтоЧеловек():Число
    Консоль.Записать("КАПЧА: СКОЛЬКО БУДЕТ 2+2?")
    возврат 4
;

метод Скрипт()
    пер ОтветКапчи:Число = ЭтоЧеловек()
    Консоль.Записать(ОтветКапчи)
;

метод ЭтоЧеловек2(): Число
    пер Кубик = новый СлучайныйГенератор()
    пер А = Кубик.СлучайноеЦелое(1,10)
    пер В = Кубик.СлучайноеЦелое(1,10)
    Консоль.Записать("КАПЧА: сколько будет $А+$В?")
    возврат А+В
;

метод Аутентифицировать(Логин:Строка,Пароль:Строка):Булево
    если Логин == "Вася" и Пароль == "123"
        возврат Истина
    иначе
        возврат Ложь
    ;
;

метод Скрипт1()
    пер Логин = Консоль.СчитатьСтроку("Введите логин: ")
    пер Пароль = Консоль.СчитатьСтроку("Введите пароль: ")
    если Аутентифицировать(Логин, Пароль)
        Консоль.Записать("Открыт доступ")
    иначе 
        Консоль.Записать("Доступ закрыт")
    ;
;